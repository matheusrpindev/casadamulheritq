{
  "name": "acolhe-itaqua",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:gerar": "drizzle-kit generate",
    "db:migrar": "node scripts/migrar.mjs",
    "db:semear": "tsx --conditions=react-server scripts/semear.ts",
    "criar-admin": "node scripts/criar-admin.mjs",
    "gerar-chaves": "node scripts/gerar-chaves.mjs",
    "build:semear": "esbuild scripts/semear.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:server-only=./tests/vazio.ts --outfile=dist-scripts/semear.mjs --log-level=warning",
    "db:verificar": "node scripts/verificar.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/pt-sans": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
