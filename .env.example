# Conexão com o PostgreSQL
DATABASE_URL=postgres://acolhe:acolhe@localhost:5432/acolhe

# Chave de criptografia dos campos sensíveis (relatos, CPF, contato…).
# 32 bytes em base64. Gere com:  npm run gerar-chaves
# ATENÇÃO: se esta chave for perdida, os dados cifrados NÃO podem ser recuperados.
# Guarde uma cópia em local seguro, separado do backup do banco.
CHAVE_CRIPTOGRAFIA=

# Chave do índice cego (HMAC) usado para buscar CPF sem guardá-lo em texto claro.
CHAVE_INDICE=

# Nome do município/rede exibido na interface
NOME_REDE="Itaquaquecetuba"

# Prefixo dos números de prontuário (ex.: ITQ-2026-000042)
PREFIXO_PRONTUARIO=ITQ

# Só para o docker-compose: senha do PostgreSQL
SENHA_BANCO=
